# Placeholders only. Copy to .env (git-ignored) and adjust. Never commit real secrets.
APP_ENV=development
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=./data/autoforge.db
ARTIFACT_ROOT=./data/artifacts
WORKSPACE_ROOT=./data/workspaces
AUTH_MODE=password            # password (built-in accounts) | proxy (behind an authenticated reverse proxy)
SESSION_SECRET=                 # required (>=32 chars) when APP_ENV=production
SANDBOX_NETWORK=none
ALLOW_WEAK_SANDBOX=0            # 1 = run checks WITHOUT namespace isolation (trusted local dev only)
MAX_RUN_SECONDS=3600
MAX_REPAIR_ATTEMPTS=2
MAX_MODEL_CALLS=120
MODEL_PROVIDER=mock
MODEL_NAME=mock-deterministic
RETENTION_DAYS=30
RUN_CREATION_PER_MINUTE=20
INLINE_WORKER=1                 # 0 = run `python -m autoforge.worker` as a separate process
# Provider API keys are referenced from the UI as env:NAME and read from the server environment:
# ANTHROPIC_API_KEY=

# --- security (NextBuild AI) ---
ALLOWED_HOSTS=127.0.0.1,localhost,[::1]   # Host header allowlist (DNS-rebinding defence); set your public name in production
ALLOW_REGISTRATION=0           # first run creates the admin; keep closed afterwards
ALLOW_REMOTE_BIND=0            # must be 1 to listen on a non-loopback HOST; only behind TLS
IDLE_TIMEOUT_MINUTES=30
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
LOGIN_PER_MINUTE_PER_IP=20
